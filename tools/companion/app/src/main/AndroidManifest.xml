<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberate posture: no QUERY_ALL_PACKAGES and no INTERNET permission.

      Launcher-intent visibility covers the apps a user actually interacts with
      without requesting broad installed-app inventory access, which Google Play
      treats as personal and sensitive data. Complete device coverage is handled
      by the desktop ADB workflow on a device the user has authorized.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="APEX Companion"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="APEX Companion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
